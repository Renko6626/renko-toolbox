    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@10.33.0"
